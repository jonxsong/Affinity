# Local-only development defaults. Never commit real credentials.
AFFINITY_API_ADDR=0.0.0.0:8080
AFFINITY_ADMIN_TOKEN=local-development-only
# Used only by the affinity-sync CLI; set real values in your shell, never here.
AFFINITY_SOURCE_TOKEN=
AFFINITY_DESTINATION_TOKEN=
DATABASE_URL=postgres://affinity:affinity@localhost:5432/affinity
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
RUST_LOG=affinity_api=info,tower_http=info
NEXT_PUBLIC_API_URL=http://localhost:8080

